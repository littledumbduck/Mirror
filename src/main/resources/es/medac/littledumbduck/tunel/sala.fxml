<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="raiz" prefHeight="900.0" prefWidth="1400.0" 
           styleClass="fondo-principal" stylesheets="@estilos.css" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="es.medac.littledumbduck.tunel.SalaController">

    <!-- CAPA 1: AMBIENTE DEL ESPEJO (OCUPA CASI TODA LA PANTALLA) -->
    <StackPane fx:id="capaEspejo" alignment="CENTER" styleClass="capa-espejo">
        <!-- Contenedor del espejo a gran tamaño -->
        <StackPane fx:id="contenedorEspejo" alignment="CENTER" styleClass="contenedor-espejo">
            <!-- Imagen del marco del espejo gótico -->
            <ImageView fx:id="imgEspejo" pickOnBounds="true" preserveRatio="true" styleClass="imagen-espejo" />

            <!-- Capa de niebla y resplandor sobre el cristal -->
            <StackPane fx:id="capaNiebla" mouseTransparent="true" styleClass="capa-niebla" />

            <!-- Textos y botón de inicio antes de comenzar la concentración -->
            <VBox alignment="CENTER" spacing="20.0" mouseTransparent="false">
                <Label fx:id="lblTitulo" styleClass="texto-maldito-titulo" text="M Í R A T E . . ." />
                <Label fx:id="lblInstruccion" styleClass="texto-instruccion" text="Mira atentamente al punto y síguelo con el ratón..." />
                
                <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#onIniciarPunto" styleClass="boton-terror" text="COMENZAR CONCENTRACIÓN" />
                <Label fx:id="lblMensajeEstado" styleClass="texto-estado" text="" />
            </VBox>

            <!-- Panel absoluto donde el punto se mueve libremente por la pantalla -->
            <Pane fx:id="panelPunto" mouseTransparent="false" pickOnBounds="false">
                <!-- Punto rojo espectral que el visitante debe seguir con el ratón -->
                <StackPane fx:id="nodoPunto" visible="false" styleClass="nodo-punto">
                    <Circle radius="18.0" styleClass="punto-anillo-exterior" />
                    <Circle radius="7.0" styleClass="punto-nucleo" />
                </StackPane>
            </Pane>
        </StackPane>
    </StackPane>

    <!-- CAPA 2: JUMPSCARE INMEDIATO (ADAPTADO PERFECTAMENTE A PANTALLA COMPLETA, 5s) -->
    <StackPane fx:id="capaJumpscare" visible="false" styleClass="capa-jumpscare">
        <!-- Fondo ambiental a pantalla completa total -->
        <ImageView fx:id="imgJumpscareFondo" opacity="0.45" pickOnBounds="true" preserveRatio="false" styleClass="imagen-jumpscare-fondo" />
        <!-- Imagen principal del jumpscare centrada a máxima resolución -->
        <ImageView fx:id="imgJumpscare" pickOnBounds="true" preserveRatio="true" styleClass="imagen-jumpscare" />
    </StackPane>

    <!-- CAPA 3: ENTREGA DE LA LETRA SECRETA "D" (TRAS LOS 5 SEGUNDOS DE SCREAM) -->
    <StackPane fx:id="capaLetra" visible="false" styleClass="capa-letra">
        <VBox alignment="CENTER" spacing="25.0">
            <Label fx:id="lblTituloLetra" styleClass="texto-victoria-titulo" text="EL ESPEJO HA LIBERADO SU SECRETO" />
            <Label fx:id="lblLetraD" styleClass="letra-revelada" text="D" />
            <Label fx:id="lblSubLetra" styleClass="subtexto-letra" text="LETRA DE LA SALA 4: D" />
            <Label fx:id="lblReinicioAviso" styleClass="texto-aviso-reinicio" text="Reiniciando sala para el siguiente grupo... (o pulsa F12)" />
        </VBox>
    </StackPane>

</StackPane>
