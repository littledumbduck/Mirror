<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz" prefHeight="900.0" prefWidth="1400.0" 
           styleClass="fondo-principal" stylesheets="@estilos.css" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="es.medac.littledumbduck.tunel.SalaController">

    <!-- CAPA 1: AMBIENTE DEL ESPEJO (OCUPA CASI TODA LA PANTALLA) -->
    <StackPane fx:id="capaEspejo" alignment="CENTER" styleClass="capa-espejo">
        <!-- Contenedor del espejo a gran tamaño -->
        <StackPane fx:id="contenedorEspejo" alignment="CENTER" styleClass="contenedor-espejo">
            <!-- Imagen del marco del espejo gótico -->
            <ImageView fx:id="imgEspejo" pickOnBounds="true" preserveRatio="true" styleClass="imagen-espejo" />

            <!-- Rostro reflejado dentro del espejo con ojos (imágenes) que siguen el cursor -->
            <StackPane fx:id="contenedorRostro" alignment="CENTER" maxWidth="520.0" maxHeight="520.0">
                <ImageView fx:id="imgRostroEspejo" fitHeight="520.0" fitWidth="520.0" opacity="0.88" pickOnBounds="true" preserveRatio="true" />
                
                <!-- Panel de ojos interactivos superpuestos en las cuencas oculares -->
                <Pane fx:id="panelOjos" prefHeight="520.0" prefWidth="520.0">
                    <!-- Ojo izquierdo: imagen que sigue al ratón dentro de la cuenca (X~192, Y~215) -->
                    <ImageView fx:id="imgOjoIzquierdo" fitHeight="38.0" fitWidth="38.0" layoutX="192.0" layoutY="215.0" pickOnBounds="true" preserveRatio="true" styleClass="imagen-ojo" />
                    <!-- Ojo derecho: imagen que sigue al ratón dentro de la cuenca (X~281, Y~212) -->
                    <ImageView fx:id="imgOjoDerecho" fitHeight="38.0" fitWidth="38.0" layoutX="281.0" layoutY="212.0" pickOnBounds="true" preserveRatio="true" styleClass="imagen-ojo" />
                </Pane>
            </StackPane>

            <!-- Capa de niebla y resplandor sobre el cristal -->
            <StackPane fx:id="capaNiebla" mouseTransparent="true" styleClass="capa-niebla" />

            <!-- Barra inferior con llamada a la acción y campo interactivo -->
            <VBox alignment="BOTTOM_CENTER" spacing="10.0" styleClass="caja-inferior" mouseTransparent="false">
                <Label fx:id="lblTitulo" styleClass="texto-maldito-titulo" text="M Í R A T E . . ." />
                <Label fx:id="lblInstruccion" styleClass="texto-instruccion" text="Sus ojos te observan... Toca el cristal o introduce lo que viste en el retrato." />
                
                <HBox fx:id="cajaInteraccion" alignment="CENTER" spacing="15.0" styleClass="caja-interaccion">
                    <TextField fx:id="txtEntrada" promptText="Introduce lo que viste en sus ojos..." styleClass="campo-terror" prefWidth="380.0" />
                    <Button fx:id="btnInteractuar" mnemonicParsing="false" onAction="#onInteractuar" styleClass="boton-terror" text="TOCAR EL CRISTAL" />
                </HBox>
                <Label fx:id="lblMensajeEstado" styleClass="texto-estado" text="" />
            </VBox>
        </StackPane>
    </StackPane>

    <!-- CAPA 2: JUMPSCARE INMEDIATO (CAMBIO DE PANTALLA REPENTINO A PANTALLA COMPLETA, 5s) -->
    <StackPane fx:id="capaJumpscare" visible="false" styleClass="capa-jumpscare">
        <ImageView fx:id="imgJumpscare" pickOnBounds="true" preserveRatio="false" styleClass="imagen-jumpscare" />
    </StackPane>

    <!-- CAPA 3: ENTREGA DE LA LETRA SECRETA "D" (TRAS LOS 5 SEGUNDOS DE SCREAM) -->
    <StackPane fx:id="capaLetra" visible="false" styleClass="capa-letra">
        <VBox alignment="CENTER" spacing="25.0">
            <Label fx:id="lblTituloLetra" styleClass="texto-victoria-titulo" text="EL ESPEJO HA LIBERADO SU SECRETO" />
            <Label fx:id="lblLetraD" styleClass="letra-revelada" text="D" />
            <Label fx:id="lblSubLetra" styleClass="subtexto-letra" text="LETRA DE LA SALA 4: D" />
            <Label fx:id="lblReinicioAviso" styleClass="texto-aviso-reinicio" text="Reiniciando sala para el siguiente grupo... (o pulsa F12)" />
        </VBox>
    </StackPane>

</StackPane>
